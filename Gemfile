# frozen_string_literal: true

source "https://rubygems.org"

# gem "rails"
gem 'jekyll', '~> 4.3.4'
gem 'jemoji', '~> 0.13.0'

# csv and webrick were removed from Ruby's default gems (csv in 3.4,
# webrick in 3.0) but jekyll 4.3.4 (2023) implicitly relies on both
# being present. Declare them explicitly for Ruby 3.4+ compatibility.
gem 'csv'
gem 'webrick'
